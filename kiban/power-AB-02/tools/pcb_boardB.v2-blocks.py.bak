def read_netlist():
    xml = '/tmp/power_AB_02_boardB.xml'
    import subprocess
    subprocess.run([B.KICAD_CLI, 'sch', 'export', 'netlist', '--format', 'kicadxml', '-o', xml, SCH],
                   capture_output=True, text=True, check=True)
    root = ET.parse(xml).getroot()
    comps = {}
    for c in root.iter('comp'):
        lib, _, name = (c.findtext('footprint') or '').partition(':')
        fields = {f.get('name'): f.text or '' for f in c.iter('field')}
        sp = c.find('sheetpath')
        comps[c.get('ref')] = {'value': c.findtext('value') or '', 'lib': lib, 'fp': name, 'lcsc': fields.get('LCSC Part', ''),
                               'path': sp.get('tstamps') + c.findtext('tstamps'), 'sheet': sp.get('names')}
    nets = {n.get('name').lstrip('/'): [(x.get('ref'), x.get('pin')) for x in n.iter('node')] for n in root.iter('net')}
    return comps, nets


def seg_rect(a, b, w):
    h = w / 2
    return (min(a[0], b[0]) - h, min(a[1], b[1]) - h, max(a[0], b[0]) + h, max(a[1], b[1]) + h)


def near_back(pl, f, tx, ty, max_r=14.0, step=0.25):
    """裏面で、目標にいちばん近い空いた位置に置く（Placer.near は表面を先に探すので、裏面専用のものを使う）。"""
    best = None
    n = int(max_r / step)
    for ix in range(-n, n + 1):
        for iy in range(-n, n + 1):
            x, y = tx + ix * step, ty + iy * step
            d = math.hypot(x - tx, y - ty)
            if best and d >= best[0]:
                continue
            for rot in (0, 90):
                if pl.free(f.rect(x, y, rot, True), True, f.tht):
                    best = (d, x, y, rot)
                    break
    assert best, f'{f.ref}: 置ける場所がない'
    f.put(best[1], best[2], best[3], True)
    pl.commit(f)


DASH, GAP_DASH = 0.8, 0.5


def draw_frames(board, frames, layer=pcbnew.B_SilkS):
    """機能ブロックの枠を点線で、名前を文字で、部品面のシルクに描く。"""
    for name, (tx, ty), pts in frames:
        for p, q in zip(pts, pts[1:] + pts[:1]):
            # この版の pcbnew は線種（破線）を Python から選べないので、短い線を並べて点線にする
            n = max(1, round(math.hypot(q[0] - p[0], q[1] - p[1]) / (DASH + GAP_DASH)))
            for i in range(n):
                a0, a1 = i / n, (i + DASH / (DASH + GAP_DASH)) / n
                s = pcbnew.PCB_SHAPE(board, pcbnew.SHAPE_T_SEGMENT)
                s.SetLayer(layer)
                s.SetStart(B.vec(p[0] + (q[0] - p[0]) * a0, p[1] + (q[1] - p[1]) * a0))
                s.SetEnd(B.vec(p[0] + (q[0] - p[0]) * a1, p[1] + (q[1] - p[1]) * a1))
                s.SetWidth(mm(0.12))
                board.Add(s)
        t = pcbnew.PCB_TEXT(board)
        t.SetText(name)
        t.SetLayer(layer)
        t.SetPosition(B.vec(tx, ty))
        t.SetTextSize(pcbnew.VECTOR2I(mm(0.8), mm(0.8)))
        t.SetTextThickness(mm(0.12))
        t.SetMirrored(layer == pcbnew.B_SilkS)
        board.Add(t)


def build():
    comps, nets = read_netlist()
    board = pcbnew.CreateEmptyBoard()
    board.SetCopperLayerCount(LAYERS)
    board.GetDesignSettings().SetBoardThickness(mm(1.6))
    netmap = {}
    for name, pins in nets.items():
        board.Add(pcbnew.NETINFO_ITEM(board, name))
        for ref, pin in pins:
            netmap[(ref, pin)] = name
    pts = B.outline_points()
    for i, p in enumerate(pts):
        s = pcbnew.PCB_SHAPE(board, pcbnew.SHAPE_T_SEGMENT)
        s.SetLayer(pcbnew.Edge_Cuts)
        s.SetStart(B.vec(*p))
        s.SetEnd(B.vec(*pts[(i + 1) % len(pts)]))
        s.SetWidth(mm(0.1))
        board.Add(s)

    parts = {}
    for ref, info in comps.items():
        B.PRETTY = LIBS[info['lib']]
        f = parts[ref] = B.Fp(ref, info, board, netmap)
        f.fp.SetFPID(pcbnew.LIB_ID(info['lib'], info['fp']))
        f.fp.SetPath(pcbnew.KIID_PATH(info['path']))             # 回路図のシンボルと結び付ける（「回路図から基板を更新」用）
        f.fp.SetSheetname(info['sheet'])
        f.fp.SetSheetfile(BOARD + '.kicad_sch')
        if info['lcsc']:
            fld = pcbnew.PCB_FIELD(f.fp, f.fp.GetNextFieldOrdinal(), 'LCSC Part')
            fld.SetText(info['lcsc'])
            fld.SetVisible(False)
            fld.SetLayer(pcbnew.F_Fab)
            f.fp.Add(fld)

    pl = B.Placer()
    for ref, (x, y, rot) in PLACE.items():
        pl.fixed(parts[ref], x, y, rot, True)

    def track(net, w, a, b):
        t = pcbnew.PCB_TRACK(board)
        t.SetStart(B.vec(*a))
        t.SetEnd(B.vec(*b))
        t.SetWidth(mm(w))
        t.SetLayer(pcbnew.B_Cu)
        t.SetNet(board.FindNet(net))
        t.SetLocked(True)
        board.Add(t)
        pl.occ[True].append(seg_rect(a, b, w))               # あとから置く部品が、配線の上に乗らないようにする

    def via(net, x, y, size=VIA_PWR):
        v = pcbnew.PCB_VIA(board)
        v.SetPosition(B.vec(x, y))
        v.SetWidth(pcbnew.F_Cu, mm(size[0]))
        v.SetDrill(mm(size[1]))
        v.SetLayerPair(pcbnew.F_Cu, pcbnew.B_Cu)
        v.SetNet(board.FindNet(net))
        v.SetLocked(True)
        board.Add(v)
        r = size[0] / 2
        pl.occ[True].append((x - r, y - r, x + r, y + r))

    for net, w, line in POWER:
        for a, b in zip(line, line[1:]):
            track(net, w, a, b)
    for x, y in GND_VIAS:
        via('GND', x, y)
    via('GND', 5.3, -1.8, VIA)                                # U3 の GND ピン 10・11（上の POWER）
    for ref, pin, dx, dy in CAP_VIAS:
        px, py = parts[ref].pad_pos(pin)
        assert netmap[(ref, pin)] == 'GND', (ref, pin)
        track('GND', 0.6, (px, py), (px + dx, py + dy))
        via('GND', px + dx, py + dy, VIA)

    # 狭ピッチの IC（U3、U1）のまわりは、ピンからの引き出しとビアのために空けておく。自動で置く部品だけが対象
    pl.occ[True].extend(KEEP_OUT)

    # 残りの部品：つながる相手（置き終わった部品のピン）のうち、いちばん小さいネットのピンの近くへ
    placed = set(PLACE)
    by_ref = {}
    for (ref, pin), nm in netmap.items():
        by_ref.setdefault(ref, {})[pin] = nm
    rest = [r for r in parts if r not in placed]
    while rest:
        best = None
        for ref in rest:
            for pin, nm in by_ref.get(ref, {}).items():
                if nm == 'GND':
                    continue
                for r2, p2 in nets[nm]:
                    if r2 in placed:
                        key = (len(nets[nm]), ref)
                        if best is None or key < best[0]:
                            best = (key, ref, parts[r2].pad_pos(p2))
        assert best, f'つながる相手が置かれていない部品：{rest}'
        _, ref, (tx, ty) = best
        near_back(pl, parts[ref], tx, ty)
        placed.add(ref)
        rest.remove(ref)

    # GND 面（In2）。部品面（B.Cu）のすぐ隣の層
    for layer in ((pcbnew.In2_Cu,) if LAYERS == 4 else (pcbnew.F_Cu, pcbnew.B_Cu)):
        z = pcbnew.ZONE(board)
        z.SetLayer(layer)
        z.SetNet(board.FindNet('GND'))
        ol = z.Outline()
        ol.NewOutline()
        for x, y in pts:
            ol.Append(mm(x), mm(y))
        z.SetMinThickness(mm(0.2))
        z.SetLocalClearance(mm(0.2 if LAYERS == 4 else 0.25))
        z.SetPadConnection(pcbnew.ZONE_CONNECTION_FULL)
        board.Add(z)

    B.silk_text(board)
    draw_frames(board, FRAMES)
    pro = OUT.replace('.kicad_pcb', '.kicad_pro')
    keep = open(pro, encoding='utf-8').read()          # SaveBoard が既定値で書き直すので戻す
    pcbnew.SaveBoard(OUT, board)
    open(pro, 'w', encoding='utf-8').write(keep)
    print(OUT)
    for ref in sorted(parts, key=lambda r: (r[0], int(''.join(c for c in r if c.isdigit()) or 0))):
        f = parts[ref]
        print(f'  {ref:4} ({f.x:7.2f}, {f.y:7.2f}) rot {f.rot:4}  {f.info["value"]}')


if __name__ == '__main__':
    build()
