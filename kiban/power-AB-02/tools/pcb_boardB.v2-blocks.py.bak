    # 残量計・保護：U1 の北に、ピンの並び順（DSG、PACK、CHG、PBI、VC2、VC1）で一列。セル電圧の直列抵抗はその上
    'R15': (-15.6, -10.5, -90), 'R10': (-14.1, -10.5, -90), 'R14': (-12.6, -10.5, -90), 'C26': (-11.1, -10.5, 90),
    'C24': (-9.6, -10.5, 90), 'C25': (-8.1, -10.5, 90),
    'R11': (-9.6, -13.3, -90), 'R12': (-8.1, -13.3, 90),
