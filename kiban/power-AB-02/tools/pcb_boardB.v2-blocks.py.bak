#!/usr/bin/env python3
"""基板B（boardB-reverse）の回路図から PCB を作る：部品配置と、電源経路の配線。KiCad 付属の Python で動かす。

  /Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/3.9/bin/python3 \
      kiban/power-AB-02/tools/pcb_boardB.py

出力：kiban/power-AB-02/boardB-reverse/boardB-reverse.kicad_pcb（信号線は未配線。続けて route.py で配線する）。
**実行すると PCB を作り直す。KiCad で手直ししたあとは実行しない。**

初版（kiban/EasyEDA/kicad/boardB-reverse）と同じにしたもの：
- 外形（40 mm 角、隅を 8 mm 面取り）、4 層、表面実装の部品はすべて裏面（B.Cu）
- 基板A へのヘッダ J2 / J3、充電入力 J1、セル J4 / J5 の位置と向き（パッドの座標とネットが初版と一致）

初版から変えたもの：
- 部品配置を電流の流れに合わせた。セル（西）→ ヒューズ → 保護 FET → 充電 IC の BAT、充電入力（東）→ VBUS、
  充電 IC の SYS → 北西の J2（VSYS）。インダクタは充電 IC の電力段（北辺）の真上
- 電流の大きい経路（下の POWER）は、このスクリプトが太い配線で引いてロックする。信号線と GND への接続は route.py（Freerouting）
- 層：B.Cu = 部品と電源、In2.Cu = GND 面（部品面のすぐ隣）、In1.Cu と F.Cu = 信号

座標は基板の中心が原点、x 右、y 下（KiCad の画面と同じ。上から見た図）。配置の道具（Fp、Placer）は初版の
kiban/EasyEDA/tools/kicad/pcb_boardB.py を使う。
"""
import math
import os
import sys
import xml.etree.ElementTree as ET

import pcbnew

HERE = os.path.dirname(os.path.abspath(__file__))
KIBAN = os.path.abspath(os.path.join(HERE, '..', '..'))
_argv, sys.argv = sys.argv, sys.argv[:1]             # 初版の道具は、読み込むときに sys.argv[1] を出力先として見る
sys.path.insert(0, os.path.join(KIBAN, 'EasyEDA', 'tools', 'kicad'))
import pcb_boardB as B  # noqa: E402
sys.argv = _argv

BOARD = 'boardB-reverse'
SCH = os.path.join(KIBAN, 'power-AB-02', BOARD, BOARD + '.kicad_sch')
OUT = os.path.join(KIBAN, 'power-AB-02', BOARD, BOARD + '.kicad_pcb')
LIBS = {
    'lcsc': os.path.join(KIBAN, 'EasyEDA', 'kicad', 'lib', 'lcsc.pretty'),
    'Connector_PinHeader_2.00mm': '/Applications/KiCad/KiCad.app/Contents/SharedSupport/footprints/Connector_PinHeader_2.00mm.pretty',
}
B.CX = B.CY = 0.0
B.SCH = SCH
B.EXTRA_NETS = {}                    # 初版の回路図にあった UUID の食い違いは直したので、補うネットは無い
GAP = 0.3                            # 部品どうしのすき間（パッドを含む外形の間）。初版の 1.0 mm では、IC のまわりに置けない
_overlap = B.overlap
B.overlap = lambda a, b, gap=GAP: _overlap(a, b, gap)
mm, tomm = pcbnew.FromMM, pcbnew.ToMM
