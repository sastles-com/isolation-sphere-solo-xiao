    'R7': (3.7, 3.0, -90), 'R3': (5.2, 3.0, -90), 'R1': (6.7, 3.0, -90), 'R2': (8.2, 3.0, -90),
    'R9': (3.7, 5.7, 90), 'R4': (5.2, 5.7, 90), 'R5': (6.7, 5.7, -90), 'R6': (8.2, 5.7, -90),
    'R8': (6.7, 8.4, 90), 'D2': (8.2, 8.4, 90),
    'J12': (11.2, 5.8, 0), 'J13': (11.2, 9.2, 0),
