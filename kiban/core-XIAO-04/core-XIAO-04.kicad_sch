	(text "電源は 3V3_MCU（モジュール内の LDO で 2.8 V）。I2C はモジュール内のレベル変換で 3.3 V、プルアップ 10 kΩ 内蔵"
		(exclude_from_sim no)
		(at 149.306 130.72 0)
		(effects
			(font
				(size 1.26 1.26)
			)
			(justify left bottom)
		)
		(uuid "0056dd58-77d3-5ea4-a722-ed5d1e26ad17")
	)
	(text "IMU（秋月 AE-BNO055-BO を直接実装）"
		(exclude_from_sim no)
		(at 149.306 126.22 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
